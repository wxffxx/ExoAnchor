menu "SI ESP32-P4 Host Configuration"

    config SI_ETH_ENABLE
        bool "Enable RJ45 Ethernet"
        default y
        select ETH_USE_ESP32_EMAC
        help
            Use the Waveshare ESP32-P4-NANO onboard 100M RJ45 Ethernet.
            The board schematic uses an IP101GR PHY connected to ESP32-P4 EMAC.

    config SI_ETH_MDC_GPIO
        int "Ethernet SMI MDC GPIO"
        default 31
        depends on SI_ETH_ENABLE

    config SI_ETH_MDIO_GPIO
        int "Ethernet SMI MDIO GPIO"
        default 52
        depends on SI_ETH_ENABLE

    config SI_ETH_PHY_RST_GPIO
        int "Ethernet PHY reset GPIO"
        default 51
        depends on SI_ETH_ENABLE

    config SI_ETH_PHY_ADDR
        int "Ethernet PHY address"
        default 1
        range -1 31
        depends on SI_ETH_ENABLE

    config SI_ETH_WAIT_IP_TIMEOUT_MS
        int "Ethernet DHCP wait timeout"
        default 15000
        range 0 120000
        depends on SI_ETH_ENABLE

    config SI_AUTH_PASSWORD
        string "Web/API bearer password"
        default "admin"
        help
            Empty string disables write API auth. The dashboard stores this as a bearer token.

    menu "Video input"

        config SI_VIDEO_ENABLE
            bool "Enable MIPI-CSI video input"
            default y
            help
                Use the ESP32-P4 MIPI-CSI controller as the video input path.

        config SI_VIDEO_CAMERA_SENSOR
            bool "Initialize a MIPI camera sensor over SCCB/I2C"
            default y
            depends on SI_VIDEO_ENABLE
            help
                Enable this for OV5647/SC2336-style camera modules connected to
                the Waveshare ESP32-P4-NANO CSI connector. Disable it when the
                source is an externally configured HDMI-to-CSI bridge emitting
                YUV422.

        config SI_VIDEO_WIDTH
            int "CSI input width"
            default 800 if SI_VIDEO_CAMERA_SENSOR
            default 1280
            depends on SI_VIDEO_ENABLE

        config SI_VIDEO_HEIGHT
            int "CSI input height"
            default 640 if SI_VIDEO_CAMERA_SENSOR
            default 720
            depends on SI_VIDEO_ENABLE

        config SI_VIDEO_DATA_LANES
            int "CSI data lanes"
            default 2
            range 1 2
            depends on SI_VIDEO_ENABLE

        config SI_VIDEO_LANE_BITRATE_MBPS
            int "CSI lane bitrate in Mbps"
            default 200 if SI_VIDEO_CAMERA_SENSOR
            default 800
            range 80 1500
            depends on SI_VIDEO_ENABLE
            help
                OV5647/SC2336 camera sensor formats in the ESP camera sensor
                driver commonly use 200 Mbps for 800x640 RAW8.
                720p60 or 1080p30 YUV422 2-lane usually starts around
                650-800 Mbps with margin. 1080p60 typically needs roughly
                1200-1350 Mbps.

        config SI_VIDEO_SENSOR_FORMAT
            string "MIPI camera sensor format name"
            default "MIPI_2lane_24Minput_RAW8_800x640_50fps"
            depends on SI_VIDEO_ENABLE && SI_VIDEO_CAMERA_SENSOR
            help
                Must match one of the format names printed by the detected
                sensor driver.

        config SI_VIDEO_SCCB_SCL_GPIO
            int "Camera SCCB/I2C SCL GPIO"
            default 8
            depends on SI_VIDEO_ENABLE && SI_VIDEO_CAMERA_SENSOR

        config SI_VIDEO_SCCB_SDA_GPIO
            int "Camera SCCB/I2C SDA GPIO"
            default 7
            depends on SI_VIDEO_ENABLE && SI_VIDEO_CAMERA_SENSOR

        config SI_VIDEO_SCCB_FREQ_HZ
            int "Camera SCCB/I2C clock"
            default 10000
            range 1000 400000
            depends on SI_VIDEO_ENABLE && SI_VIDEO_CAMERA_SENSOR

        config SI_VIDEO_SENSOR_RESET_GPIO
            int "Camera sensor reset GPIO (-1 for none)"
            default -1
            depends on SI_VIDEO_ENABLE && SI_VIDEO_CAMERA_SENSOR

        config SI_VIDEO_SENSOR_PWDN_GPIO
            int "Camera sensor power-down GPIO (-1 for none)"
            default -1
            depends on SI_VIDEO_ENABLE && SI_VIDEO_CAMERA_SENSOR

        config SI_VIDEO_BYTE_SWAP
            bool "Enable CSI byte swap"
            default n
            depends on SI_VIDEO_ENABLE && !SI_VIDEO_CAMERA_SENSOR
            help
                Toggle this when LT6911C YUV422 byte order is wrong.

        config SI_VIDEO_JPEG_QUALITY
            int "MJPEG/JPEG quality"
            default 75
            range 1 100
            depends on SI_VIDEO_ENABLE

        config SI_VIDEO_STREAM_DELAY_MS
            int "MJPEG frame delay"
            default 120
            range 20 1000
            depends on SI_VIDEO_ENABLE

        config SI_VIDEO_MIPI_LDO_ENABLE
            bool "Enable internal LDO for MIPI PHY"
            default y
            depends on SI_VIDEO_ENABLE

        config SI_VIDEO_MIPI_LDO_CHAN_ID
            int "MIPI PHY LDO channel ID"
            default 3
            depends on SI_VIDEO_ENABLE && SI_VIDEO_MIPI_LDO_ENABLE

        config SI_VIDEO_MIPI_LDO_VOLTAGE_MV
            int "MIPI PHY LDO voltage"
            default 2500
            range 0 3300
            depends on SI_VIDEO_ENABLE && SI_VIDEO_MIPI_LDO_ENABLE

    endmenu

endmenu
