# Registry sources stay untouched; fail closed if their pinned bytes change.
idf_component_get_property(si_uvc_security_lib espressif__usb_host_uvc COMPONENT_LIB)
idf_component_get_property(si_uvc_security_dir espressif__usb_host_uvc COMPONENT_DIR)
function(si_replace_uvc_source filename expected_hash)
    set(original "${si_uvc_security_dir}/${filename}")
    file(SHA256 "${original}" actual_hash)
    if(NOT actual_hash STREQUAL expected_hash)
        message(FATAL_ERROR "UVC ${filename} changed; review BBP 573 backport")
    endif()
    get_target_property(sources ${si_uvc_security_lib} SOURCES)
    list(FIND sources "${original}" index)
    if(index EQUAL -1)
        message(FATAL_ERROR "UVC ${filename} is absent from compiled source list")
    endif()
    list(REMOVE_ITEM sources "${original}")
    list(APPEND sources "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/usb_host_uvc-2.5.1/${filename}")
    set_property(TARGET ${si_uvc_security_lib} PROPERTY SOURCES "${sources}")
endfunction()
si_replace_uvc_source(uvc_descriptor_parsing.c "d1adc2f3928ced2e040c92817d18cfc3c1d813fe2c889a2a22167d1bb09cf945")
