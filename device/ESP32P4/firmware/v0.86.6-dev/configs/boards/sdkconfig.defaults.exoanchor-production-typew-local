# Local-only TypeW W0.1 profile. The legacy filename/board ID predates the W0.1 label.
# Formal W repairs DAT2/DAT3 and must not inherit the two swapped mappings below.
# Netlist_量产版SCH_W_2026-08-19.tel
# SHA-256: ff7f2440b40089bfca91d1a0c6ef069a092e604a81d717f30ce4d0bcc7efe460
CONFIG_SI_BOARD_EXOANCHOR_PRODUCTION_TYPEW=y

# Preserve NVS: this serial flash update does not erase saved network,
# authentication, or local settings.
# CONFIG_SI_RESET_SETTINGS_ON_NEW_IMAGE is not set

# MS2109 production power sequence: 3V3_MS first, then 1V2_SYS.
CONFIG_SI_MS2109_POWER_ENABLE=y
CONFIG_SI_MS2109_SWITCH_GPIO=22
CONFIG_SI_MS2109_SWITCH_ACTIVE_HIGH=y
CONFIG_SI_MS2109_CORE_ENABLE_GPIO=23
CONFIG_SI_MS2109_CORE_ENABLE_ACTIVE_HIGH=y
CONFIG_SI_MS2109_POWER_SEQUENCE_DELAY_MS=10

# DP83825I management pins differ from the other ExoAnchor layouts.
CONFIG_SI_ETH_MDC_GPIO=10
CONFIG_SI_ETH_MDIO_GPIO=11
CONFIG_SI_ETH_PHY_RST_GPIO=20

# Target ATX controls, active-low state inputs, and locator LED.
CONFIG_SI_POWER_BUTTON_GPIO=50
CONFIG_SI_RESET_BUTTON_GPIO=49
CONFIG_SI_POWER_ACTIVE_HIGH=y
CONFIG_SI_POWER_DETECT_GPIO=51
# CONFIG_SI_POWER_DETECT_ACTIVE_HIGH is not set
CONFIG_SI_STANDBY_DETECT_GPIO=52
# CONFIG_SI_STANDBY_DETECT_ACTIVE_HIGH is not set
CONFIG_SI_POWER_LOCATOR_GPIO=21
CONFIG_SI_POWER_LOCATOR_RETURN_GPIO=46
CONFIG_SI_POWER_LOCATOR_ACTIVE_HIGH=y

CONFIG_SI_TF_CARD_DETECT_GPIO=-1
CONFIG_SI_TF_SDMMC_D2_GPIO=42
CONFIG_SI_TF_SDMMC_D3_GPIO=41
CONFIG_SI_TF_SDMMC_LOW_SPEED_FALLBACK=y
CONFIG_SI_TF_SDMMC_LOW_SPEED_FREQ_KHZ=10000
CONFIG_SI_MS2109_EEPROM_WP_GPIO=-1
# CONFIG_SI_TARGET_UART_ENABLE is not set
# CONFIG_SI_MS2109_EEPROM_EMULATOR_ENABLE is not set
# CONFIG_SI_MS2109_TEST_ENABLE is not set

CONFIG_ESP_CONSOLE_UART_DEFAULT=y
