# ExoAnchor P4 V2.4 product profile.
# This is the normal Dev/Stable composition: use production rail sequencing,
# expose only the GPIO16 WP UART control, and keep the physical-EEPROM
# programmer and emulator implementations excluded.
CONFIG_SI_BOARD_EXOANCHOR_PROTOTYPE_V24=y
CONFIG_SI_ETH_PHY_DP83825=y

# TPS22918 enables 3V3_MS from GPIO13, then GPIO18 enables the 1.2 V rail.
CONFIG_SI_MS2109_POWER_ENABLE=y
CONFIG_SI_MS2109_SWITCH_GPIO=13
CONFIG_SI_MS2109_SWITCH_ACTIVE_HIGH=y
CONFIG_SI_MS2109_CORE_ENABLE_GPIO=18
CONFIG_SI_MS2109_CORE_ENABLE_ACTIVE_HIGH=y
CONFIG_SI_MS2109_POWER_SEQUENCE_DELAY_MS=10

# AT24C16 is physically routed on GPIO47/48 with WP on GPIO16. Product firmware
# reserves and reports the wiring and exposes eeprom-wp status/write-enable/
# protect on UART, but must not compile its programmer, emulator, or HTTP routes.
CONFIG_SI_MS2109_EEPROM_WP_GPIO=16
CONFIG_SI_MS2109_EEPROM_SCL_GPIO=47
CONFIG_SI_MS2109_EEPROM_SDA_GPIO=48
# CONFIG_SI_MS2109_TEST_ENABLE is not set
# CONFIG_SI_MS2109_EEPROM_EMULATOR_ENABLE is not set

CONFIG_SI_POWER_BUTTON_GPIO=4
CONFIG_SI_RESET_BUTTON_GPIO=5
CONFIG_SI_POWER_ACTIVE_HIGH=y
CONFIG_SI_POWER_DETECT_GPIO=0
CONFIG_SI_POWER_DETECT_ACTIVE_HIGH=y
CONFIG_SI_STANDBY_DETECT_GPIO=1
CONFIG_SI_STANDBY_DETECT_ACTIVE_HIGH=y
CONFIG_SI_POWER_LOCATOR_GPIO=17
CONFIG_SI_POWER_LOCATOR_ACTIVE_HIGH=y
CONFIG_SI_POWER_LOCATOR_RETURN_GPIO=-1

CONFIG_SI_TF_CARD_DETECT_GPIO=-1

CONFIG_SI_TARGET_UART_ENABLE=y
CONFIG_SI_TARGET_UART_PORT=1
CONFIG_SI_TARGET_UART_RX_GPIO=50
CONFIG_SI_TARGET_UART_TX_GPIO=51
CONFIG_SI_TARGET_UART_BAUD_RATE=115200
CONFIG_SI_TARGET_UART_FALLBACK_BAUD_RATE=9600

CONFIG_SI_HID_USB_DM_GPIO=26
CONFIG_SI_HID_USB_DP_GPIO=27

CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
