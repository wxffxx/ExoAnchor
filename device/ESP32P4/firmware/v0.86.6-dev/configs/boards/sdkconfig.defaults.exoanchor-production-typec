# Netlist_量产版SCH_2026-08-06.tel
# SHA-256: 30422e276d4e4377111a3ff144cdcef61838ac2fb119a4ceecf93d6c209cf37b
# Production TypeC uses the single ESP32-P4 module. The connected first board
# reports silicon revision v1.3, so this profile must use esp32p4-rev1.
CONFIG_SI_BOARD_EXOANCHOR_PRODUCTION_TYPEC=y

# U5 switches 3V3_SYS to 3V3_MS from GPIO17. U10 generates 1V2_SYS from
# 3V3_MS and is enabled by GPIO18. Both enables have 100k pulldowns.
CONFIG_SI_MS2109_POWER_ENABLE=y
CONFIG_SI_MS2109_SWITCH_GPIO=17
CONFIG_SI_MS2109_SWITCH_ACTIVE_HIGH=y
CONFIG_SI_MS2109_CORE_ENABLE_GPIO=18
CONFIG_SI_MS2109_CORE_ENABLE_ACTIVE_HIGH=y
CONFIG_SI_MS2109_POWER_SEQUENCE_DELAY_MS=10

# U17/U18 are active-high optocoupler LED drives. U20 senses 12V on GPIO52
# and U19 senses 3V3AUX on GPIO53 through active-low open-collector outputs.
# The production-board locator LED is confirmed on GPIO19. In the netlist its
# route is GPIO19 -> R19 (22 ohm) -> U22.1, with the remaining U22 pins at GND.
CONFIG_SI_POWER_BUTTON_GPIO=50
CONFIG_SI_RESET_BUTTON_GPIO=51
CONFIG_SI_POWER_ACTIVE_HIGH=y
CONFIG_SI_POWER_DETECT_GPIO=52
# CONFIG_SI_POWER_DETECT_ACTIVE_HIGH is not set
CONFIG_SI_STANDBY_DETECT_GPIO=53
# CONFIG_SI_STANDBY_DETECT_ACTIVE_HIGH is not set
CONFIG_SI_POWER_LOCATOR_GPIO=19
CONFIG_SI_POWER_LOCATOR_ACTIVE_HIGH=y

# The production review verifies the four-bit SDMMC bus but does not freeze a
# dedicated card-detect GPIO. Do not claim one.
CONFIG_SI_TF_CARD_DETECT_GPIO=-1

# GPIO50/GPIO51 are Power/Reset outputs on the production board, not a target
# UART. The physical AT24C16 is not wired to the P4; never expose test writes.
CONFIG_SI_MS2109_EEPROM_WP_GPIO=-1
# CONFIG_SI_TARGET_UART_ENABLE is not set
# CONFIG_SI_MS2109_EEPROM_EMULATOR_ENABLE is not set
# CONFIG_SI_MS2109_TEST_ENABLE is not set

CONFIG_ESP_CONSOLE_UART_DEFAULT=y
